# Backend API Webhook URL
BACKEND_WEBHOOK_URL=http://localhost:5000/api/webhook/match
BACKEND_ENROLLMENTS_URL=http://localhost:5000/api/students/embeddings

# Camera Source (0 for laptop webcam, 1 for external USB, or RTSP URL e.g. rtsp://user:pass@192.168.1.50:554/stream)
CAMERA_SOURCE=0

# Processing Configuration
FRAME_THROTTLE_SECONDS=3.0
YOLO_CONFIDENCE=0.50
MATCH_CONFIDENCE_THRESHOLD=0.65
MODEL_NAME=Facenet512

# Headless / GUI Mode (Set to false on servers without desktop display)
SHOW_DISPLAY_WINDOW=true
